# Mangohick Fire Reporting System - Client Production Configuration
# Domain: reporting.mangohickfire.com

# API Configuration
REACT_APP_API_URL=https://reporting.mangohickfire.com/api

# Google Integration
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id
REACT_APP_MAPS_API_KEY=your-google-maps-api-key

# PWA Configuration
REACT_APP_PWA_ENABLED=true
REACT_APP_OFFLINE_ENABLED=true
REACT_APP_VOICE_ENABLED=true
REACT_APP_AI_ENABLED=true

# Application Configuration
REACT_APP_APP_NAME=Mangohick Fire Reporting
REACT_APP_APP_VERSION=1.0.0
REACT_APP_DOMAIN=reporting.mangohickfire.com

# NEMSIS Configuration
REACT_APP_NEMSIS_VERSION=3.5
REACT_APP_AGENCY_ID=MANGOHICK-VFD-001

# Virginia State Configuration
REACT_APP_STATE=VA
REACT_APP_COUNTY=Hanover



