{
  "name": "mangohick-fire-reporting",
  "version": "1.0.0",
  "description": "NEMSIS 3.5 and NFIRS/NERIS reporting site for Mangohick Volunteer Fire Department",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "test-neris": "node test-neris.js"
  },
  "keywords": [
    "nemsis",
    "nfirs",
    "fire",
    "reporting",
    "epcrs",
    "cad"
  ],
  "author": "Mangohick Volunteer Fire Department",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "expo-server-sdk": "^3.13.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "googleapis": "^128.0.0",
    "helmet": "^7.1.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.0",
    "sequelize": "^6.32.1",
    "sequelize-cli": "^6.6.1",
    "xmldom": "^0.6.0",
    "xml2js": "^0.6.2",
    "xpath": "^0.0.34"
  }
}
