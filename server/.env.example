# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/mangohick-fire-reporting

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-here

# Google APIs
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback

# Virginia State Upload
VA_STATE_API_URL=https://api.virginia.gov/fire-reporting
VA_STATE_API_KEY=your-virginia-api-key

# Federal Upload (NEMSIS)
FEDERAL_API_URL=https://nemsis.org/api
FEDERAL_API_KEY=your-federal-api-key

# CAD System Integration
CAD_SYSTEM_URL=https://your-cad-system.com/api
CAD_API_KEY=your-cad-api-key

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads