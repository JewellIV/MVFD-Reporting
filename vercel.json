{
  "version": 2,
  "installCommand": "npm install",
  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node",
      "includeFiles": [
        "server/**",
        "node_modules/mysql2/**",
        "node_modules/sequelize/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}

