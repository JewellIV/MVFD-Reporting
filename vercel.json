{
  "version": 2,
  "buildCommand": "npm install && cd client && npm install && npm run build && cd .. && mkdir -p public && cp -r client/build/* public/",
  "installCommand": "npm install",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node",
      "includeFiles": "server/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}

